# Create a key at https://developer.clashroyale.com and whitelist your home/server public IP on it.
CR_API_KEY=paste-your-key-here
# Clan tag #292GQ80L is built in; only set CLAN_TAG (in quotes) to manage a different clan.

# If your public IP changes (typical home broadband), use the RoyaleAPI proxy instead:
# 1) whitelist the proxy IP shown at https://docs.royaleapi.com/proxy.html on your key
# 2) uncomment:
# CR_API_BASE=https://proxy.royaleapi.dev/v1

# Optional: password for the dashboard (basic auth, any username). Leave unset on a trusted home network.
# APP_PASSWORD=change-me
# Optional: Discord webhook for reminders/alerts (can also be set in the Settings tab)
# DISCORD_WEBHOOK_URL=
